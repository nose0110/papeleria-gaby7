{% extends "layouts/main.html.twig" %}
{% block title %}{{ mode == 'new' ? 'Nuevo Producto' : 'Editar Producto' }}{% endblock %}
{% block content %}
<div class="row">
  <div class="col-md-8">
    <h1>{{ mode == 'new' ? 'Nuevo Producto' : 'Editar Producto' }}</h1>
    <br>
    <div class="card">
      <div class="card-header">{{ mode == 'new' ? 'NUEVO PRODUCTO' : 'EDITAR PRODUCTO' }}</div>
      <div class="card-body">
        <form method="post" action="{{ mode == 'new' ? base_url ~ '/beterrware/product/create' : base_url ~ '/beterrware/product/' ~ product.id ~ '/update' }}">
          {{ csrf_field() }}
          <div class="mb-3">
            <label class="form-label">Nombre*</label>
            <input type="text" name="name" required class="form-control"
                   value="{{ product.name|default(old.name|default('')) }}" placeholder="Ej. Betabel rallado">
          </div>
          <div class="mb-3">
            <label class="form-label">Descripcion</label>
            <textarea name="description" class="form-control" rows="3" placeholder="Descripcion del producto">{{ product.description|default(old.description|default('')) }}</textarea>
          </div>
          <div class="row">
            <div class="col-md-4 mb-3">
              <label class="form-label">Stock</label>
              <input type="number" name="stock" min="0" step="1" class="form-control"
                     value="{{ product.stock|default(old.stock|default(0)) }}">
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label">Precio*</label>
              <input type="number" name="price" min="0" step="0.01" required class="form-control"
                     value="{{ product.price|default(old.price|default('')) }}" placeholder="0.00">
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label">Codigo</label>
              <input type="text" name="code" class="form-control"
                     value="{{ product.code|default(old.code|default('')) }}" placeholder="Ej. BW-001">
            </div>
          </div>
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-save"></i> {{ mode == 'new' ? 'Agregar Producto' : 'Actualizar Producto' }}
          </button>
          <a href="{{ base_url }}/beterrware/products" class="btn btn-link">Cancelar</a>
        </form>
      </div>
    </div>
  </div>
</div>
{% endblock %}
