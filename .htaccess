<IfModule mod_rewrite.c>
    RewriteEngine On
    # Bloquear acceso directo al archivo .env desde el navegador
    <FilesMatch "^\.env">
        Require all denied
    </FilesMatch>
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
